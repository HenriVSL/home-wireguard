# Copy to .env and adjust. Restart (docker compose up -d) after changes;
# profiles are regenerated, re-import them on devices if DNS/routes changed.

# Image built and tested by GitHub Actions
IMAGE=ghcr.io/OWNER/home-wireguard:latest

# Public name clients connect to, and the port forwarded on the router (UDP)
WG_HOST=vpn.example.com
WG_PORT=51820

# DNS server pushed to clients (both profiles)
WG_DNS=192.168.1.201

# Networks the "lan" profile routes through the tunnel (comma separated)
WG_LAN_ROUTES=192.168.1.0/24

# VPN-internal addresses: <prefix>.1 = server, .2-.254 = clients
WG_SUBNET_PREFIX=10.66.66
